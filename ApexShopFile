<!DOCTYPE html>
<html lang="fa" dir="rtl" ><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>APEX SHOP</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230a0a0a'/%3E%3Cpath d='M10 28l6-12 6 8 6-14 6 14 6-8 6 12H10z' fill='%23d4af37'/%3E%3Crect x='16' y='30' width='32' height='16' rx='3' fill='%233b82f6'/%3E%3C/svg%3E">
<style>
  :root {
    --gold: #d4af37;
    --gold-light: #e8c36a;
    --gold-dark: #b8941f;
    --blue: #3b82f6;
    --blue-light: #60a5fa;
    --blue-dark: #1d4ed8;
    --black: #0a0a0a;
    --dark: #111827;
    --card: #1a1f2e;
    --card2: #232a3b;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --border: rgba(212, 175, 55, 0.35);
  }
  body {
    margin: 0;
    color: var(--text);
    font-family: Tahoma, sans-serif;
    background:#070b12 url('data:image/jpeg;base64,') center/cover fixed no-repeat;
  }
  body:before {
    content: '';
    position: fixed;
    inset: 0;
    background: linear-gradient(180deg, rgba(8,10,16,.78), rgba(10,12,20,.84));
    pointer-events: none;
    z-index: 0;
  }
  header, main { position: relative; z-index: 1; }

  /* پنل اصلی فروشگاه: برجسته از پس‌زمینه با خط آبی متحرک و ظریف */
  main.wrap {
    position: relative;
    width: min(1180px, calc(100% - 28px));
    box-sizing: border-box;
    margin: 22px auto 40px;
    padding: 6px 18px 28px;
    background: linear-gradient(180deg, rgba(10, 17, 29, .78), rgba(8, 13, 23, .88));
    border: 1px solid rgba(37, 99, 235, .48);
    border-radius: 24px;
    box-shadow:
      0 18px 55px rgba(0, 0, 0, .48),
      0 0 0 1px rgba(59, 130, 246, .05) inset,
      0 0 28px rgba(29, 78, 216, .10);
    isolation: isolate;
    overflow: hidden;
    animation: panelFloat 5s ease-in-out infinite;
  }
  main.wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(115deg, rgba(37,99,235,.10), rgba(37,99,235,.95), rgba(96,165,250,.30), rgba(37,99,235,.10), rgba(37,99,235,.95));
    background-size: 260% 260%;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: borderFlow 5s linear infinite;
    pointer-events: none;
    z-index: 3;
  }
  main.wrap::after {
    content: '';
    position: absolute;
    top: 0;
    left: 8%;
    width: 84%;
    height: 2px;
    border-radius: 99px;
    background: linear-gradient(90deg, transparent 0%, rgba(37,99,235,.15) 18%, #2563eb 48%, #60a5fa 52%, rgba(37,99,235,.15) 82%, transparent 100%);
    box-shadow: 0 0 8px rgba(37,99,235,.9), 0 0 20px rgba(37,99,235,.35);
    transform-origin: center;
    animation: lineSweep 2.8s ease-in-out infinite;
    pointer-events: none;
    z-index: 3;
  }
  @keyframes panelFloat {
    0%, 100% { box-shadow: 0 18px 55px rgba(0,0,0,.48), 0 0 0 1px rgba(59,130,246,.05) inset, 0 0 24px rgba(29,78,216,.08); }
    50% { box-shadow: 0 20px 58px rgba(0,0,0,.50), 0 0 0 1px rgba(59,130,246,.08) inset, 0 0 34px rgba(29,78,216,.14); }
  }
  @keyframes borderFlow {
    0% { background-position: 0% 50%; filter: brightness(.9); }
    50% { background-position: 100% 50%; filter: brightness(1.25); }
    100% { background-position: 0% 50%; filter: brightness(.9); }
  }
  @keyframes lineSweep {
    0%, 100% { opacity: .38; transform: scaleX(.72); }
    50% { opacity: 1; transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    main.wrap, main.wrap::before, main.wrap::after { animation: none; }
  }
  header {
    background: linear-gradient(180deg, #0d1118 0%, #151c28 100%);
    border-bottom: 1px solid var(--border);
    padding-top: 6px;
  }
  .wrap { width: min(1180px, calc(100% - 28px)); margin: auto; }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0 14px;
    gap: 16px;
  }
  .logo { font-weight: 900; font-size: 24px; color: #f5f5f5; }
  .logo span { color: var(--gold-light); }
  button, input, textarea, select { font-family: inherit; }
  .btn {
    border: 1px solid var(--border);
    background: #1a1520;
    color: #f8f1df;
    border-radius: 12px;
    padding: 10px 14px;
    cursor: pointer;
    transition: 0.15s ease;
  }
  .tab {
    background: #1a1520;
    border-color: rgba(59, 130, 246, 0.35);
  }
  .tab.on {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    color: #fff;
    border: 0;
  }
  .btn:hover { filter: brightness(1.08); }
  .gold {
    background: linear-gradient(135deg, var(--gold-light), var(--gold-dark));
    color: #1a1200;
    border: 0;
    font-weight: 800;
  }
  .blue {
    background: linear-gradient(135deg, var(--blue-light), var(--blue-dark));
    color: #fff;
    border: 0;
    font-weight: 800;
  }
  .back {
    background: #b91c1c;
    color: #fff;
    border: 0;
    font-weight: 800;
    margin-top: 18px;
    margin-bottom: 8px;
  }
  .on {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    color: #fff;
    border: 0;
  }
  h1 { margin: 28px 0 8px; }
  .searchbox {
    margin: 22px 0 26px;
    position: relative;
    display: flex;
    gap: 10px;
    align-items: stretch;
  }
  .searchbox input {
    flex: 1;
    box-sizing: border-box;
    padding: 14px 16px;
  }
  .searchbox .btn {
    flex-shrink: 0;
    min-width: 110px;
  }
  .layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 22px;
    align-items: start;
  }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .boxside {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 14px;
  }
  .boxside h3 { margin: 0 0 12px; color: var(--blue-light); font-size: 15px; }
  .side .btn { width: 100%; margin-bottom: 8px; text-align: right; }
  .side label { display: block; color: var(--blue-light); font-size: 13px; margin: 10px 0 6px; }
  input, textarea, select {
    width: 100%;
    box-sizing: border-box;
    background: var(--card2);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--gold); transform: translateY(-2px); }
  .card img, .ph {
    width: 100%;
    height: 160px;
    object-fit: cover;
    background: #2a3642;
    display: block;
  }
  .body { padding: 14px; }
  .tag { color: var(--blue-light); font-size: 12px; }
  .name { margin: 6px 0 4px; font-weight: 800; font-size: 18px; }
  .desc { margin: 0 0 8px; font-weight: 400; color: var(--muted); line-height: 1.7; }
  .price { display: block; margin: 10px 0 12px; }
  .price-old { text-decoration: line-through; color: var(--muted); font-size: 13px; margin-left: 8px; }
  .sale-badge, .free-badge { display:inline-block; padding:4px 9px; border-radius:999px; font-size:12px; font-weight:800; margin:4px 0; }
  .sale-badge { background:rgba(239,68,68,.16); color:#fca5a5; border:1px solid rgba(239,68,68,.35); }
  .free-badge { background:rgba(34,197,94,.16); color:#86efac; border:1px solid rgba(34,197,94,.35); }
  .download-note { margin-top:8px; font-size:12px; color:var(--muted); }
  .price b { font-weight: 800; font-size: 20px; color: var(--gold-light); }
  .actions { display: flex; gap: 8px; }
  .hide { display: none; }
  .form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .full { grid-column: 1 / -1; }
  textarea { min-height: 80px; }
  .previews, .thumbs { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .previews img, .thumbs img {
    width: 74px; height: 56px; object-fit: cover; border-radius: 8px; cursor: pointer;
  }
  .page {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 16px;
    margin: 18px 0 24px;
  }
  .page img.big {
    width: 100%; height: 360px; object-fit: cover; border-radius: 14px; background: #2a3642;
  }
  .feat { margin: 8px 0 0; padding: 0 18px; }
  .feat li { margin: 6px 0; }
  .suggest {
    position: absolute;
    right: 0; left: 130px; top: 56px;
    z-index: 6;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: none;
    overflow: hidden;
    max-height: 280px;
    overflow-y: auto;
  }
  .suggest button {
    display: block; width: 100%; text-align: right;
    background: transparent; border: 0; color: var(--text);
    padding: 10px 12px; cursor: pointer;
  }
  .suggest button:hover { background: rgba(59, 130, 246, 0.15); }
  .mini {
    display: flex; justify-content: space-between; gap: 8px;
    padding: 8px 0; border-bottom: 1px solid rgba(212,175,55,.15); cursor: pointer;
  }
  .stat { display: flex; justify-content: space-between; margin: 6px 0; color: var(--muted); }
  .boxes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin: 22px 0 36px; }
  .act {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 16px;
  }
  .act h3 { margin: 0 0 8px; color: var(--blue-light); }
  #account { min-height: 70vh; }
  .faq { display: none; }
  .faq.show { display: block; }
  @media (max-width: 860px) {
    .boxes { grid-template-columns: 1fr; }
    .searchbox { flex-direction: column; }
    .suggest { left: 0; }
  }
  .side { position: sticky; top: 16px; }
  .menu {
    position: fixed; inset: 0; background: rgba(0,0,0,.62);
    display: none; align-items: center; justify-content: center;
    padding: 16px; z-index: 30;
  }
  .menu.open { display: flex; }
  .sheet {
    width: min(460px, 100%);
    background: var(--card);
    border: 1px solid rgba(212,175,55,.4);
    border-radius: 20px;
    padding: 18px;
  }
  .sheet h2 { margin: 0 0 8px; }
  .sheet .btn { width: 100%; margin-top: 8px; }
  .faq { margin: 28px 0 40px; }
  .faq item, .qitem {
    background: var(--card);
    border: 1px solid rgba(212,175,55,.25);
    border-radius: 14px;
    margin: 10px 0;
    overflow: hidden;
  }
  .qitem button {
    width: 100%; text-align: right; background: transparent; border: 0;
    color: #d7eef8; padding: 14px; cursor: pointer; font-weight: 800;
  }
  .qitem p { margin: 0; padding: 0 14px 14px; color: var(--muted); line-height: 1.8; }
  @media (max-width: 860px) {
    .layout, .form, .page { grid-template-columns: 1fr; }
    .page img.big { height: 220px; }
  }

  /* ---- فیلتر نوع فروش ---- */
  .filter-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .filter-chip {
    border: 1px solid rgba(59,130,246,.35);
    background: #1a1520;
    color: #e2e8f0;
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    transition: .2s ease;
  }
  .filter-chip:hover { border-color: var(--gold); color: var(--gold-light); }
  .filter-chip.on {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    color: #fff;
    border-color: transparent;
    box-shadow: 0 4px 14px rgba(37,99,235,.35);
  }
  .filter-chip.free.on {
    background: linear-gradient(135deg, #22c55e, #15803d);
    box-shadow: 0 4px 14px rgba(34,197,94,.3);
  }
  .filter-chip.paid.on {
    background: linear-gradient(135deg, var(--gold-light), var(--gold-dark));
    color: #1a1200;
    box-shadow: 0 4px 14px rgba(212,175,55,.3);
  }

  /* ---- انیمیشن کارت‌ها ---- */
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(18px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes softPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(212,175,55,.35); }
    50% { box-shadow: 0 0 0 8px rgba(212,175,55,0); }
  }
  @keyframes shine {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
  .card {
    animation: cardIn .45s ease both;
    transition: border-color .25s, transform .25s, box-shadow .25s;
  }
  .card:nth-child(1) { animation-delay: .03s; }
  .card:nth-child(2) { animation-delay: .07s; }
  .card:nth-child(3) { animation-delay: .11s; }
  .card:nth-child(4) { animation-delay: .15s; }
  .card:nth-child(5) { animation-delay: .19s; }
  .card:nth-child(6) { animation-delay: .23s; }
  .card:nth-child(n+7) { animation-delay: .27s; }
  .card:hover {
    border-color: var(--gold);
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0,0,0,.35), 0 0 0 1px rgba(212,175,55,.2);
  }
  .card img { transition: transform .4s ease; }
  .card:hover img { transform: scale(1.04); }

  .btn.gold {
    position: relative;
    overflow: hidden;
  }
  .btn.gold:hover { animation: softPulse 1.4s ease infinite; }

  /* ---- صفحه جزئیات ارتقا یافته ---- */
  #detail { animation: fadeUp .4s ease both; }
  .page {
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,.35);
  }
  .page::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(600px 200px at 100% 0%, rgba(59,130,246,.12), transparent 60%);
  }
  .detail-meta {
    display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 12px;
  }
  .meta-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 999px;
    background: rgba(59,130,246,.12);
    border: 1px solid rgba(59,130,246,.28);
    color: var(--blue-light); font-size: 12px; font-weight: 700;
  }
  .meta-pill.gold {
    background: rgba(212,175,55,.12);
    border-color: rgba(212,175,55,.35);
    color: var(--gold-light);
  }
  .meta-pill.green {
    background: rgba(34,197,94,.12);
    border-color: rgba(34,197,94,.35);
    color: #86efac;
  }
  .price-box {
    margin: 16px 0;
    padding: 14px 16px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(212,175,55,.08), rgba(59,130,246,.06));
    border: 1px solid var(--border);
  }
  .price-box .final-label { color: var(--muted); font-size: 13px; margin-bottom: 4px; }
  .price-box .big-price b { font-size: 28px; color: var(--gold-light); }
  .boxes { gap: 16px; }
  .act {
    transition: transform .2s, border-color .2s, box-shadow .2s;
    animation: fadeUp .5s ease both;
  }
  .act:nth-child(1) { animation-delay: .05s; }
  .act:nth-child(2) { animation-delay: .12s; }
  .act:nth-child(3) { animation-delay: .18s; }
  .act:hover {
    transform: translateY(-3px);
    border-color: rgba(212,175,55,.5);
    box-shadow: 0 10px 28px rgba(0,0,0,.25);
  }
  .act .btn { width: 100%; margin-top: 8px; }
  .download-note {
    margin-top: 10px; font-size: 13px; color: var(--muted); line-height: 1.6;
  }
  .trust-row {
    display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px;
  }
  .trust-item {
    flex: 1; min-width: 120px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(148,163,184,.15);
    font-size: 12px; color: var(--muted); text-align: center;
  }
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 20px;
    color: var(--muted);
    animation: fadeUp .4s ease;
  }
  .empty-state b { display: block; color: var(--text); font-size: 18px; margin-bottom: 8px; }

  .side .boxside { animation: fadeUp .45s ease both; }
  .side .boxside:nth-child(1) { animation-delay: .02s; }
  .side .boxside:nth-child(2) { animation-delay: .06s; }
  .side .boxside:nth-child(3) { animation-delay: .1s; }
  .side .boxside:nth-child(4) { animation-delay: .14s; }
  .side .boxside:nth-child(5) { animation-delay: .18s; }

  .searchbox .btn.blue:hover {
    filter: brightness(1.1);
    box-shadow: 0 6px 20px rgba(37,99,235,.35);
  }

  @media (max-width: 860px) {
    .filter-row { gap: 6px; }
    .filter-chip { padding: 7px 12px; font-size: 12px; }
  }


  /* ---- جریان خرید انیمیشنی ---- */
  .menu {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .menu .sheet {
    max-width: 420px;
    max-height: 90vh;
    overflow-y: auto;
    animation: sheetIn .4s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes sheetIn {
    from { opacity: 0; transform: translateY(28px) scale(.94); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .coin-stage {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 8px 0 4px;
  }
  .coin {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    position: relative;
    background:
      radial-gradient(circle at 32% 28%, #fff6d0 0%, #f0d078 22%, #d4a017 55%, #9a7209 100%);
    border: 3px solid rgba(255, 236, 180, .9);
    box-shadow:
      0 12px 32px rgba(212,175,55,.5),
      inset 0 3px 10px rgba(255,255,255,.5),
      inset 0 -5px 12px rgba(0,0,0,.22);
    animation: coinPop 1.45s cubic-bezier(.22,1,.36,1) both;
  }
  .coin-inner {
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 2px solid rgba(139, 105, 20, .35);
    background:
      radial-gradient(circle at 40% 35%, rgba(255,255,255,.25), transparent 55%),
      repeating-conic-gradient(from 0deg, rgba(184,148,31,.15) 0deg 8deg, transparent 8deg 16deg);
    box-shadow: inset 0 0 0 6px rgba(212,175,55,.2);
  }
  .coin-shine {
    position: absolute;
    top: 10px; left: 16px;
    width: 28px; height: 18px;
    border-radius: 50%;
    background: rgba(255,255,255,.45);
    filter: blur(3px);
    pointer-events: none;
  }
  @keyframes coinPop {
    0% { opacity: 0; transform: translateY(60px) scale(.2) rotate(-40deg); }
    55% { opacity: 1; transform: translateY(-12px) scale(1.12) rotate(12deg); }
    75% { transform: translateY(4px) scale(.96) rotate(-4deg); }
    100% { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
  }
  .coin-ring {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid rgba(232,195,106,.45);
    animation: ringExpand 1.35s ease-out both;
  }
  @keyframes ringExpand {
    0% { opacity: 0; transform: scale(.4); }
    40% { opacity: .8; }
    100% { opacity: 0; transform: scale(1.6); }
  }
  .pay-step-title {
    text-align: center;
    font-size: 18px;
    font-weight: 900;
    margin: 0 0 6px;
  }
  .pay-step-sub {
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    margin: 0 0 16px;
    line-height: 1.7;
  }
  .pay-product {
    background: rgba(255,255,255,.03);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    margin-bottom: 14px;
  }
  .pay-product .pname { font-weight: 800; font-size: 16px; margin: 0 0 6px; }
  .pay-product .prow {
    display: flex; justify-content: space-between; gap: 10px;
    color: var(--muted); font-size: 13px; margin: 6px 0;
  }
  .pay-product .prow b { color: var(--gold-light); font-size: 15px; }
  .bank-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1.586 / 1;
    border-radius: 18px;
    padding: 18px 20px;
    box-sizing: border-box;
    background:
      linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #1d4ed8 70%, #0ea5e9 100%);
