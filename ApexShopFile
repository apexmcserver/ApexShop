    '<h2>پرداخت</h2>' +
    '<p class="desc">محصولات: ' + names + '</p>' +
    '<p class="desc">مبلغ: <b style="color:var(--gold-light)">' + new Intl.NumberFormat("fa-IR").format(total) + ' تومان</b></p>' +
    '<p class="desc">بعد از واریز، فیش را برای پشتیبانی بفرست. خرید فقط وقتی در پروفایلت می‌آید که ادمین آن را ثبت کند.</p>' +
    '<button class="btn gold" id="payBale" type="button">بله · @ApexmcSupport</button>' +
    '<button class="btn" id="payRubika" type="button" style="margin-top:8px">روبیکا · @ApexmcSupports</button>';
  document.getElementById("backAfterPay").onclick = showShop;
  document.getElementById("payBale").onclick = () => window.open("https://ble.ir/ApexmcSupport", "_blank");
  document.getElementById("payRubika").onclick = () => window.open("https://rubika.ir/ApexmcSupports", "_blank");
}
