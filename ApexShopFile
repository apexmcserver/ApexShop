function requireAccount(afterFn, why) {
  const u = me(), info = users()[u];
  if (u && info && validPhone(info.phone)) return true;
  pendingAction = afterFn || null;
  accNotice = why || "برای خرید یا دانلود باید حساب داشته باشی.";
  showAccount();
  return false;
}
function finishAuth() {
  const info = users()[me()];
  if (!info || !validPhone(info.phone)) { showAccount(); return; }
  const fn = pendingAction; pendingAction = null; accNotice = "";
  if (fn) fn(); else showAccount();
}
