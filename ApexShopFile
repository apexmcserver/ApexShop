    color: #fff;
    margin: 10px 0 14px;
    animation: cardFlipIn .6s cubic-bezier(.22,1,.36,1) both;
  }
  .bank-card::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -20%;
    width: 70%;
    height: 120%;
    background: radial-gradient(circle, rgba(255,255,255,.18), transparent 60%);
    pointer-events: none;
  }
  .bank-card::after {
    content: '';
    position: absolute;
    right: -30px;
    bottom: -40px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
  }
  @keyframes cardFlipIn {
    from { opacity: 0; transform: rotateY(-18deg) translateY(20px) scale(.92); }
    to { opacity: 1; transform: rotateY(0) translateY(0) scale(1); }
  }
  .bank-card .chip {
    width: 42px;
    height: 32px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f5d76e, #c9a227 40%, #e8c36a 70%, #a67c00);
