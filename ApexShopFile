function wireAdminControls() {
  const form = document.getElementById("form");
  if (form) form.onsubmit = e => {
    e.preventDefault();
    const item = {
      id: editing || Date.now(),
      name: document.getElementById("fName").value.trim(),
      category: document.getElementById("fCat").value.trim(),
      saleType: document.getElementById("fSaleType").value,
      price: Number(document.getElementById("fPrice").value) || 0,
      discount: Number(document.getElementById("fDiscount").value) || 0,
      downloadUrl: document.getElementById("fDownload").value.trim(),
      version: document.getElementById("fVer").value.trim(),
      format: document.getElementById("fFmt").value.trim(),
      badge: document.getElementById("fBadge").value.trim(),
      description: document.getElementById("fDesc").value.trim(),
      features: document.getElementById("fFeat").value.split("\n").map(x => x.trim()).filter(Boolean),
      images: images.slice()
    };
    if (editing) products = products.map(p => String(p.id) === String(editing) ? item : p);
    else products.unshift(item);
    save(); resetForm(); render(); showAdmin();
  };
