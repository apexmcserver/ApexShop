    justify-content: space-between;
    align-items: flex-end;
    position: relative;
    z-index: 1;
  }
  .bank-card .clabel {
    font-size: 10px;
    opacity: .7;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }
  .bank-card .cname {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: .5px;
  }
  .bank-card .brand {
    font-size: 13px;
    font-weight: 900;
    opacity: .9;
  }
  .copy-row {
