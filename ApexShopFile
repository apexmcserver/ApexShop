function listNow() {
  const q = document.getElementById("q").value.trim();
  const min = Number(document.getElementById("minPrice").value);
  const max = Number(document.getElementById("maxPrice").value);
  let list = products.filter(p => (filter === "همه" || p.category === filter) && match(p, q));
  if (saleFilter === "free") list = list.filter(p => p.saleType === "free");
  if (saleFilter === "paid") list = list.filter(p => (p.saleType || "paid") !== "free");
  if (document.getElementById("minPrice").value !== "") list = list.filter(p => finalPrice(p) >= min);
  if (document.getElementById("maxPrice").value !== "") list = list.filter(p => finalPrice(p) <= max);
  const sort = document.getElementById("sort").value;
  if (q && sort === "new") list = list.slice().sort((a, b) => score(a, q) - score(b, q));
  if (sort === "cheap") list = list.slice().sort((a, b) => finalPrice(a) - finalPrice(b));
  if (sort === "expensive") list = list.slice().sort((a, b) => finalPrice(b) - finalPrice(a));
  if (sort === "discount") list = list.slice().sort((a, b) => (Number(b.discount)||0) - (Number(a.discount)||0));
  return list;
}
function render() {
  const cats = ["همه", ...new Set(products.map(p => p.category).filter(Boolean))];
  document.getElementById("tabs").innerHTML = cats.map(c => {
    const n = c === "همه" ? products.length : products.filter(p => p.category === c).length;
    return '<button class="btn tab ' + (c === filter ? "on" : "") + '" data-c="' + c + '" type="button">' + c + " (" + n + ")</button>";
  }).join("");
  document.querySelectorAll("#tabs button").forEach(b => b.onclick = () => { filter = b.dataset.c; page = 1; render(); });
  const list = listNow();
  const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
  if (page > pages) page = pages;
  const view = list.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
  document.getElementById("count").textContent = String(list.length);
  document.getElementById("catCount").textContent = String(cats.length - 1);
  document.getElementById("sideList").innerHTML = products.slice(0, 6).map(p => '<div class="mini" data-open="' + p.id + '"><b>' + esc(p.name) + "</b><span>" + (p.saleType === "free" ? "رایگان" : new Intl.NumberFormat("fa-IR").format(finalPrice(p))) + "</span></div>").join("");
