    padding: 12px;
    font-size: 13px;
    color: #bbf7d0;
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .pay-hint.warn {
    background: rgba(212,175,55,.08);
    border-color: rgba(212,175,55,.3);
