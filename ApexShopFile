  el.innerHTML = '<button class="btn back" id="backShopAcc" type="button">برگشت به فروشگاه</button><h2>پروفایل ' + esc(info.name) + '</h2><p class="desc">نام کاربری: ' + esc(user) + '</p><p class="desc">شماره تلفن: ' + esc(info.phone) + '</p><div class="actions"><button class="btn" id="renameBtn" type="button">عوض کردن اسم</button><button class="btn back" id="logoutBtn" type="button">خروج</button></div><h3>خریدهای ثبت‌شده</h3><p class="desc">فقط خریدهایی که ادمین برایت ثبت کرده اینجا دیده می‌شود.</p><div class="grid">' + ((info.purchases || []).length ? info.purchases.map(o => '<article class="card"><div class="body"><h3 class="name">' + esc(o.name) + '</h3></div></article>').join('') : '<p class="desc">خریدی ثبت نشده.</p>') + '</div><h3>ذخیره‌ها</h3><div class="grid">' +
    (saved.length ? saved.map(item => '<article class="card"><div class="body"><h3 class="name">' + esc(item.name) + '</h3><div class="actions"><button class="btn" data-open="' + item.id + '" type="button">مشاهده</button><button class="btn back" data-del="' + item.id + '" type="button">حذف</button></div></div></article>').join("") : '<p class="desc">چیزی ذخیره نشده.</p>') + '</div>';
  document.getElementById("backShopAcc").onclick = showShop;
  accNotice = "";
  document.getElementById("logoutBtn").onclick = () => { clearMe(); showAccount(); };
  document.getElementById("renameBtn").onclick = () => {
    const name = prompt("اسم جدید");
    if (!name) return;
    const data = users();
    data[user].name = name.trim();
    saveUsers(data);
    showAccount();
  };
  el.querySelectorAll("[data-open]").forEach(b => b.onclick = () => openItem(b.dataset.open));
  el.querySelectorAll("[data-del]").forEach(b => b.onclick = () => removeSaved(b.dataset.del));
}
function cart() { try { const c = JSON.parse(lsGet("apex-cart") || "[]"); return Array.isArray(c) ? c : []; } catch (e) { return []; } }
function saveCart(list) { lsSet("apex-cart", JSON.stringify(list)); updateCartBadge(); }
function inCart(id) { return cart().includes(String(id)); }
function updateCartBadge() {
  const b = document.getElementById("toCart");
  if (!b) return;
  const n = cart().filter(id => find(id)).length;
  b.textContent = n ? "سبد (" + new Intl.NumberFormat("fa-IR").format(n) + ")" : "سبد";
}
function addCart(p) {
  if (!requireAccount(() => { addCart(p); openItem(p.id); }, "برای خرید باید حساب داشته باشی.")) return;
  const list = cart();
  if (!list.includes(String(p.id))) list.push(String(p.id));
