<script>
const KEY = "apex-shop-v5";

/* ===== ذخیره‌سازی ماندگار =====
   همه‌چیز در localStorage نگه داشته می‌شود (نه sessionStorage) و یک نسخه پشتیبان
   هم در IndexedDB ساخته می‌شود تا اگر مرورگر localStorage را پاک کرد، حساب برگردد. */
const MIRROR_KEYS = ["apex-user", "apex-users", "apex-profile", "apex-cart", "apex-accounts"];
const memStore = {};
const idb = (() => {
  let dbp = null;
  function open() {
    if (dbp) return dbp;
    dbp = new Promise((res, rej) => {
      try {
        const r = indexedDB.open("apex-db", 1);
        r.onupgradeneeded = () => r.result.createObjectStore("kv");
        r.onsuccess = () => res(r.result);
        r.onerror = () => rej(r.error);
      } catch (e) { rej(e); }
    });
    return dbp;
  }
  return {
    set(k, v) { return open().then(db => new Promise((res, rej) => { const tx = db.transaction("kv", "readwrite"); tx.objectStore("kv").put(v, k); tx.oncomplete = res; tx.onerror = () => rej(tx.error); })).catch(() => {}); },
    del(k) { return open().then(db => new Promise((res, rej) => { const tx = db.transaction("kv", "readwrite"); tx.objectStore("kv").delete(k); tx.oncomplete = res; tx.onerror = () => rej(tx.error); })).catch(() => {}); },
    all() { return open().then(db => new Promise((res, rej) => { const out = []; const rq = db.transaction("kv", "readonly").objectStore("kv").openCursor(); rq.onsuccess = () => { const c = rq.result; if (c) { out.push([c.key, c.value]); c.continue(); } else res(out); }; rq.onerror = () => rej(rq.error); })).catch(() => []); }
  };
})();
function lsGet(k) { try { const v = localStorage.getItem(k); if (v !== null) return v; } catch (e) {} return Object.prototype.hasOwnProperty.call(memStore, k) ? memStore[k] : null; }
function lsSet(k, v) { memStore[k] = v; try { localStorage.setItem(k, v); } catch (e) {} if (MIRROR_KEYS.includes(k)) idb.set(k, v); }
function lsDel(k) { delete memStore[k]; try { localStorage.removeItem(k); } catch (e) {} if (MIRROR_KEYS.includes(k)) idb.del(k); }
try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch (e) {}
function restoreFromBackup() {
  return idb.all().then(list => { let changed = false; list.forEach(([k, v]) => { if (lsGet(k) === null) { memStore[k] = v; try { localStorage.setItem(k, v); } catch (e) {} changed = true; } }); return changed; });
}

/* ===== شماره تلفن ===== */
function normDigits(v) {
  return String(v || "").replace(/[۰-۹]/g, d => "۰۱۲۳۴۵۶۷۸۹".indexOf(d)).replace(/[٠-٩]/g, d => "٠١٢٣٤٥٦٧٨٩".indexOf(d)).replace(/[\s\-]/g, "");
}
function validPhone(v) { return /^09\d{9}$/.test(normDigits(v)); }
