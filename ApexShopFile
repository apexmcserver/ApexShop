      <aside class="side">
        <div class="boxside">
          <button class="btn" id="sideProfile" type="button">پروفایل</button><h3>دسته‌ها</h3>
          <div id="tabs"><button class="btn tab " data-c="همه" type="button">همه (4)</button><button class="btn tab on" data-c="Maps/Schematic" type="button">Maps/Schematic (4)</button></div>
        </div>
        <div class="boxside">
          <h3>نوع فروش</h3>
          <div class="filter-row" id="saleTabs">
            <button class="filter-chip on" data-sale="all" type="button">همه</button>
            <button class="filter-chip paid" data-sale="paid" type="button">پولی</button>
            <button class="filter-chip free" data-sale="free" type="button">رایگان</button>
          </div>
        </div>
        <div class="boxside">
          <h3>مرتب‌سازی و قیمت</h3>
          <select id="sort">
            <option value="new">جدید</option>
            <option value="cheap">ارزان‌ترین</option>
            <option value="expensive">گران‌ترین</option>
