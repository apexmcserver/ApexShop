    '<div class="body"><div class="tag">' + esc(p.badge || p.category) + (p.version ? " · " + esc(p.version) : "") + (p.saleType === "free" ? ' · رایگان' : '') + '</div><h3 class="name">' + esc(p.name) + '</h3><p class="desc">' + esc(p.description) + '</p><div class="price">' + priceHtml(p) + '</div><div class="actions">' +
