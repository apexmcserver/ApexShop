  el.classList.remove("hide");
  const items = cart().map(id => find(id)).filter(Boolean);
  const total = items.reduce((s, p) => s + finalPrice(p), 0);
  el.innerHTML = '<button class="btn back" id="backShopCart" type="button">برگشت به فروشگاه</button><h2>سبد خرید</h2><div class="grid">' +
    (items.length ? items.map(p => '<article class="card"><div class="body"><h3 class="name">' + esc(p.name) + '</h3><div class="price">' + priceHtml(p) + '</div><button class="btn back" data-rm="' + p.id + '" type="button">حذف از سبد</button></div></article>').join("") : '<p class="desc">سبد خالی است.</p>') +
    '</div><h3>جمع: ' + new Intl.NumberFormat("fa-IR").format(total) + ' تومان</h3>' +
    (items.length > 1 ? '<button class="btn gold" id="payAll" type="button">پرداخت یکجا</button>' : (items.length === 1 ? '<button class="btn gold" id="payOne" type="button">پرداخت</button>' : ''));
