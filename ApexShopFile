}

function copyText(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text.replace(/\s/g, "")).then(() => showToast("شماره کارت کپی شد")).catch(() => fallbackCopy(text));
  } else fallbackCopy(text);
}
function fallbackCopy(text) {
  const ta = document.createElement("textarea");
  ta.value = text.replace(/\s/g, "");
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand("copy"); showToast("شماره کارت کپی شد"); } catch (e) { showToast(text); }
  ta.remove();
}

