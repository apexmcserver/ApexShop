  /* ---- لوگو برجسته ---- */
  .logo {
    font-weight: 900;
    font-size: 26px;
    letter-spacing: 1px;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    position: relative;
    animation: logoBreathe 3.2s ease-in-out infinite;
  }
  .logo-apex {
    background: linear-gradient(110deg, #60a5fa 0%, #3b82f6 35%, #1d4ed8 55%, #38bdf8 75%, #60a5fa 100%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: logoShine 3.5s linear infinite;
    filter: drop-shadow(0 0 10px rgba(59,130,246,.55));
    font-weight: 900;
  }
  .logo-shop {
    background: linear-gradient(110deg, #f5e6a8 0%, #e8c36a 40%, #d4af37 60%, #fff3c4 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: logoShine 3.5s linear infinite reverse;
    filter: drop-shadow(0 0 8px rgba(212,175,55,.45));
    font-weight: 900;
  }
  @keyframes logoShine {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
  @keyframes logoBreathe {
    0%, 100% { transform: translateY(0) scale(1); filter: brightness(1); }
    50% { transform: translateY(-4px) scale(1.04); filter: brightness(1.08); }
  }
  .logo::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6px;
    height: 3px;
    border-radius: 99px;
    background: linear-gradient(90deg, transparent, #3b82f6, #60a5fa, #e8c36a, transparent);
    opacity: .85;
    animation: underGlow 2.8s ease-in-out infinite;
  }
  @keyframes underGlow {
