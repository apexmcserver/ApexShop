let picked = null;
function finalPrice(p) { if (p.saleType === "free") return 0; const base = Math.max(0, Number(p.price) || 0); const d = Math.min(100, Math.max(0, Number(p.discount) || 0)); return Math.round(base * (1 - d / 100)); }
function priceHtml(p) { if (p.saleType === "free") return '<span class="free-badge">رایگان</span>'; const base = Math.max(0, Number(p.price) || 0); const d = Math.min(100, Math.max(0, Number(p.discount) || 0)); const final = finalPrice(p); return (d > 0 ? '<span class="sale-badge">' + d + '% تخفیف</span><br><span class="price-old">' + toman(base) + '</span>' : '') + toman(final); }
function toman(n) { return "<b>" + new Intl.NumberFormat("fa-IR").format(n) + "</b><span> تومان</span>"; }
function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
function save() { try { localStorage.setItem(KEY, JSON.stringify(products)); } catch (e) { alert("حافظه مرورگر پر است؛ تعداد یا حجم عکس‌ها را کمتر کن."); } }
function cover(p) { return (p.images && p.images[0]) || ""; }
function find(id) { return products.find(x => String(x.id) === String(id)); }
function norm(s) {
  return normDigits(String(s || "")).toLowerCase()
    .replace(/[\u064B-\u065F\u0670\u0640]/g, "")      // اعراب و کشیده
    .replace(/\u200c/g, " ")                           // نیم‌فاصله
    .replace(/ي/g, "ی").replace(/ك/g, "ک").replace(/[آأإ]/g, "ا").replace(/ة/g, "ه").replace(/ؤ/g, "و").replace(/ئ/g, "ی")
    .replace(/[\/\\|\-_.,،؛:()\[\]{}*+&@#!?؟"'«»]+/g, " ")  // علامت‌ها
    .replace(/\s+/g, " ").trim();
}
// جستجو فقط روی عنوان (نام) محصول انجام می‌شود
function match(p, query) {
  const q = norm(query);
  if (!q) return true;
  const name = norm(p.name);
  if (name.includes(q)) return true;
  const words = q.split(" ").filter(Boolean);
  return words.every(w => name.includes(w));
}
function score(p, query) {
  const q = norm(query), name = norm(p.name);
  if (!q) return 0;
  if (name.startsWith(q)) return 0;
  if (name.split(" ").some(w => w.startsWith(q))) return 1;
  if (name.includes(q)) return 2;
  return 3;
}
function suggest() {
  const box = document.getElementById("suggest");
  const q = document.getElementById("q").value.trim();
  if (!q) { box.style.display = "none"; return; }
  const hits = products.filter(p => match(p, q)).sort((a, b) => score(a, q) - score(b, q)).slice(0, 6);
  if (!hits.length) { box.style.display = "none"; return; }
  box.style.display = "block";
  box.innerHTML = hits.map(p => '<button type="button" data-pick="' + p.id + '">' + esc(p.name) + "</button>").join("");
  box.querySelectorAll("[data-pick]").forEach(b => b.onclick = () => {
    document.getElementById("q").value = find(b.dataset.pick).name;
    box.style.display = "none";
    page = 1;
    render();
  });
}
