    margin-bottom: 22px;
    position: relative;
    z-index: 1;
  }
  .bank-card .chip::after {
    content: '';
    position: absolute;
    inset: 6px 4px;
    border: 1px solid rgba(0,0,0,.15);
    border-radius: 3px;
  }
  .bank-card .cnum {
    font-family: Consolas, monospace;
    font-size: clamp(15px, 4.2vw, 20px);
    letter-spacing: 2.5px;
    font-weight: 700;
    margin-bottom: 18px;
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 2px rgba(0,0,0,.3);
